{
  "name": "@corbits/oauth-core",
  "version": "0.1.0",
  "description": "Provider-agnostic OAuth 2.0 authorization-code + PKCE login for desktop/CLI hosts.",
  "license": "LGPL-2.1-or-later",
  "author": "Sawyer Cutler <sawyer@dirtroad.dev>",
  "type": "module",
  "sideEffects": false,
  "files": [
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test"
  },
  "dependencies": {
    "arktype": "2.2.3"
  },
  "devDependencies": {
    "@eslint/js": "9.34.0",
    "@types/bun": "1.3.9",
    "eslint": "9.34.0",
    "jiti": "2.5.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.42.0"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/corbitsdev/corbits-oauth-core.git"
  }
}
