{
  "name": "@corbits/oauth-core",
  "version": "0.2.0",
  "description": "Provider-agnostic OAuth 2.0 authorization-code + PKCE login for desktop/CLI hosts.",
  "homepage": "https://github.com/corbitsdev/corbits-oauth-core",
  "bugs": {
    "url": "https://github.com/corbitsdev/corbits-oauth-core/issues"
  },
  "license": "LGPL-2.1-only",
  "author": "Sawyer Cutler <sawyer@dirtroad.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/corbitsdev/corbits-oauth-core.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./hub": {
      "types": "./dist/hub/index.d.ts",
      "default": "./dist/hub/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "bun test",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test"
  },
  "dependencies": {
    "@intx/db": "^0.4.0",
    "@intx/hub-api": "^0.4.0",
    "@intx/hub-common": "^0.4.0",
    "@intx/types": "^0.4.0",
    "arktype": "^2.2.3",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.11.9"
  },
  "devDependencies": {
    "@types/bun": "1.3.9",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "bun": ">=1.2.0",
    "node": ">=24"
  }
}
