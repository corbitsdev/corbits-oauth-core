{
  "name": "@corbits/oauth-core",
  "version": "0.1.0",
  "description": "Provider-agnostic OAuth 2.0 authorization-code + PKCE login for desktop/CLI hosts.",
  "license": "LGPL-2.1-only",
  "author": "Sawyer Cutler <sawyer@dirtroad.dev>",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./hub": {
      "types": "./dist/hub/index.d.ts",
      "default": "./dist/hub/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test"
  },
  "dependencies": {
    "arktype": "^2.2.3",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.11.9",
    "@intx/db": "^0.4.0",
    "@intx/hub-api": "^0.4.0",
    "@intx/hub-common": "^0.4.0",
    "@intx/types": "^0.4.0"
  },
  "devDependencies": {
    "@eslint/js": "9.34.0",
    "@types/bun": "1.3.9",
    "eslint": "9.34.0",
    "jiti": "2.5.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.42.0"
  },
  "engines": {
    "bun": ">=1.2.0",
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/corbitsdev/corbits-oauth-core.git"
  },
  "homepage": "https://github.com/corbitsdev/corbits-oauth-core",
  "bugs": {
    "url": "https://github.com/corbitsdev/corbits-oauth-core/issues"
  }
}
